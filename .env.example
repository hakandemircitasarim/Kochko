# KOCHKO environment — copy to .env and fill in real values.
# The .env file is gitignored; never commit real keys.

# ─── Supabase ─────────────────────────────────────────────
# Find these in your Supabase project at https://supabase.com/dashboard > Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── OpenAI (edge-function side only; never expose to client) ─
# Set this as a Supabase secret, not in the client .env.
#   supabase secrets set OPENAI_API_KEY=sk-...
# Client code never reads this — only edge functions do via Deno.env.

# ─── Sentry (optional, Phase E) ───────────────────────────
# EXPO_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# ─── PostHog analytics (optional, Phase E) ────────────────
# EXPO_PUBLIC_POSTHOG_KEY=phc_...
# EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
