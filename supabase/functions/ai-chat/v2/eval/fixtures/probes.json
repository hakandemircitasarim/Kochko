{
  "group": "probes",
  "defaults": {
    "persona": "fresh",
    "tags": ["probe"],
    "turn_input": { "now": { "local_time": "21:30" } }
  },
  "fixtures": [
    {
      "id": "probe-cap-bir-bardak-su-daha",
      "source": "probe:cap-schema",
      "package": "A",
      "title": "cap-probe: ‘1 bardak su daha içtim’ → 1 bardak, ekle, 0,20 L.",
      "message": "1 bardak su daha içtim",
      "turn_input": {},
      "expect": [
        { "path": "decision.writes[op=water_log].quantity", "eq": 1 },
        { "path": "decision.writes[op=water_log].unit", "in": ["bardak", "su_bardagi"] },
        { "path": "decision.writes[op=water_log].mode", "eq": "add" },
        { "path": "commit.water_log.liters", "between": [0.15, 0.30] }
      ]
    },
    {
      "id": "probe-cap-alti-tavuk-nugget",
      "source": "probe:cap-schema",
      "package": "A",
      "title": "cap-probe: ‘6 tavuk nugget yedim’ → 100–120 g, 290–360 kcal civarı; tavuk göğsü referansı seçilmez.",
      "turn_input": {
        "reference_candidates": [ { "key": "tavuk göğsü", "line": "tavuk göğsü: 165 kcal/100 g · P31 K0 Y3,6 · porsiyon ≈150 g" } ]
      },
      "message": "6 tavuk nugget yedim",
      "expect": [
        { "path": "decision.writes[op=meal_log].items[name~nugget].kcal", "between": [220, 450] },
        { "path": "decision.writes[op=meal_log].items[name~nugget].grams", "between": [60, 200] },
        { "path": "decision.writes[op=meal_log].items[*].reference_key", "not_in": ["tavuk göğsü", "tavuk_gogsu", "tavuk gogsu"] }
      ]
    },
    {
      "id": "probe-cap-mercimek-iki-cimdik-tuz",
      "source": "probe:cap-schema",
      "package": "A",
      "title": "cap-probe: ‘2 çimdik tuz’ aynen saklanır, ~0,7–1 g, 0 kcal; asla reddedilmez (§4.3).",
      "message": "akşam 1 tabak mercimek çorbası içtim, içine 2 çimdik tuz attım",
      "turn_input": {},
      "expect": [
        { "path": "decision.writes[op=meal_log].items[*]", "count": 2 },
        { "path": "decision.writes[op=meal_log].meal_type", "eq": "dinner" },
        { "path": "decision.writes[op=meal_log].items[name~tuz].as_stated", "contains": "çimdik" },
        { "path": "decision.writes[op=meal_log].items[name~tuz].grams", "lte": 3 },
        { "path": "decision.writes[op=meal_log].items[name~tuz].kcal", "lte": 1 },
        { "path": "decision.writes[op=water_log]", "count": 0 },
        { "path": "validation.writes[op=meal_log].outcome", "ne": "reject" }
      ]
    },
    {
      "id": "probe-cap-bugun-toplam-iki-litre",
      "source": "probe:cap-schema",
      "package": "A",
      "title": "cap-probe: ‘bugün toplam 2 litre su içtim’ → günün toplamını ayarla.",
      "message": "bugün toplam 2 litre su içtim",
