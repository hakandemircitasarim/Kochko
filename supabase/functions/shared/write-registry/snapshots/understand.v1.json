      }
     },
     "required": [
      "food",
      "kcal_estimate",
      "target_day"
     ],
     "additionalProperties": false
    },
    {
     "type": "null"
    }
   ]
  },
  "clarify": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "topic": {
       "type": "string",
