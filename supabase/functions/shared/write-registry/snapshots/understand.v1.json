{
 "type": "object",
 "properties": {
  "intent": {
   "type": "object",
   "properties": {
    "primary": {
     "type": "string",
     "enum": [
      "report",
      "question",
      "hypothetical",
      "correction",
      "confirmation",
      "plan",
      "chat",
      "other"
     ]
    },
    "is_hypothetical": {
     "type": "boolean",
     "description": "mesajın ana kısmı varsayım mı"
    },
    "about_other_person": {
     "type": "boolean",
     "description": "mesaj başkası hakkında mı (kızı, arkadaşı…)"
    }
   },
   "required": [
    "primary",
    "is_hypothetical",
    "about_other_person"
   ],
   "additionalProperties": false
  },
  "safety": {
   "type": "object",
   "properties": {
    "acute_medical": {
     "type": "boolean",
     "description": "şu an acil tıbbi durum var mı (anafilaksi, göğüs ağrısı, nefes darlığı…)"
    },
    "self_harm": {
     "type": "boolean",
     "description": "kendine zarar verme düşüncesi/niyeti var mı"
    },
    "ed_signal": {
     "anyOf": [
      {
       "type": "object",
       "properties": {
        "category": {
         "type": "string",
         "enum": [
          "restriction",
          "purging",
          "binge",
          "compensatory_exercise",
          "body_image",
          "illness_vomiting"
         ]
        },
        "severity": {
         "type": "string",
         "enum": [
          "low",
          "medium",
          "high"
         ]
        },
        "evidence_quote": {
         "type": "string",
         "description": "KULLANICININ mesajından AYNEN alıntı (koçun sözleri sayılmaz)"
        }
       },
       "required": [
        "category",
        "severity",
        "evidence_quote"
       ],
       "additionalProperties": false
      },
      {
       "type": "null"
      }
     ]
    },
    "tripwire_reading": {
     "anyOf": [
      {
       "type": "object",
       "description": "yalnız TETİK olgusu verildiyse doldur; yoksa null",
       "properties": {
        "benign": {
         "type": "boolean",
         "description": "tetik kelimesi zararsız anlamda mı (\"bayıldım\" = çok sevdim)"
        },
        "reason": {
         "type": "string"
        }
       },
       "required": [
        "benign",
        "reason"
       ],
       "additionalProperties": false
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "acute_medical",
    "self_harm",
    "ed_signal",
    "tripwire_reading"
   ],
   "additionalProperties": false
  },
  "writes": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/write"
   }
  },
  "record_ops": {
   "type": "array",
   "items": {
    "anyOf": [
     {
      "type": "object",
      "description": "Kaydı geri al/sil",
      "properties": {
       "op": {
        "type": "string",
        "enum": [
         "delete"
        ]
       },
       "ref": {
        "type": "string",
        "description": "m|d|w|s|t|e|l|f-ref (ör. m3)"
       },
       "reason": {
        "type": "string",
        "description": "neden geri alındığı, kısaca"
       }
      },
      "required": [
       "op",
       "ref",
       "reason"
      ],
      "additionalProperties": false
     },
     {
      "type": "object",
      "description": "Kaydı düzelt",
      "properties": {
       "op": {
        "type": "string",
        "enum": [
         "update"
        ]
       },
       "ref": {
        "type": "string",
        "description": "m|d|w|s|t|e|l|f-ref (ör. m3)"
       },
       "basis": {
        "type": "string",
        "enum": [
         "user_correction",
         "suspicious"
        ]
       },
       "reason": {
        "type": "string",
        "description": "neyin yanlış olduğu (\"6 nugget için 1708 kcal çok yüksek\")"
       },
       "evidence_quote": {
        "type": [
         "string",
         "null"
        ],
        "description": "user_correction ise kullanıcının mesajından AYNEN alıntı; suspicious ise null"
       },
       "patch": {
        "$ref": "#/$defs/write"
       }
      },
      "required": [
       "op",
       "ref",
       "basis",
       "reason",
       "evidence_quote",
       "patch"
      ],
      "additionalProperties": false
     },
     {
      "type": "object",
      "description": "Metriği önceki değerine döndür",
      "properties": {
       "op": {
        "type": "string",
        "enum": [
         "restore_metric"
        ]
       },
       "ref": {
        "type": "string",
        "description": "d-ref (ör. d3)"
       },
       "reason": {
        "type": "string"
       }
      },
      "required": [
       "op",
       "ref",
       "reason"
      ],
      "additionalProperties": false
     }
    ]
   }
  },
  "pending_ops": {
   "type": "array",
   "items": {
    "anyOf": [
     {
      "type": "object",
      "description": "Bekleyeni onayla",
      "properties": {
       "op": {
        "type": "string",
        "enum": [
         "confirm"
        ]
       },
       "ref": {
        "type": "string",
        "description": "p-ref (ör. p3)"
       }
      },
      "required": [
       "op",
       "ref"
      ],
      "additionalProperties": false
     },
     {
      "type": "object",
      "description": "Bekleyenden vazgeç",
      "properties": {
       "op": {
        "type": "string",
        "enum": [
         "discard"
        ]
       },
       "ref": {
        "type": "string",
        "description": "p-ref (ör. p3)"
       }
      },
      "required": [
       "op",
       "ref"
      ],
      "additionalProperties": false
     }
    ]
   }
  },
  "commitment_ops": {
   "type": "array",
   "items": {
    "anyOf": [
     {
      "type": "object",
      "description": "Söz/taahhüt",
      "properties": {
       "op": {
        "type": "string",
        "enum": [
         "add"
        ]
       },
       "text": {
        "type": "string",
        "description": "sözün kısa, net hâli"
       },
       "follow_up_days": {
        "type": "number",
        "description": "kaç gün sonra sorulsun"
       }
      },
      "required": [
       "op",
       "text",
       "follow_up_days"
      ],
      "additionalProperties": false
     },
     {
      "type": "object",
      "description": "Söz sonucu",
      "properties": {
       "op": {
        "type": "string",
        "enum": [
         "resolve"
        ]
       },
       "ref": {
        "type": "string",
        "description": "k-ref (ör. k3)"
       },
       "outcome": {
        "type": "string",
        "enum": [
         "kept",
         "missed",
         "partial"
        ]
       },
       "note": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "op",
       "ref",
       "outcome",
       "note"
      ],
      "additionalProperties": false
     }
    ]
   }
  },
  "plan_action": {
   "type": "object",
   "properties": {
    "op": {
     "type": "string",
     "enum": [
      "none",
      "generate",
      "revise",
      "explain",
      "approve",
      "discard"
     ]
    },
    "plan_type": {
     "type": [
      "string",
      "null"
     ],
     "enum": [
      "diet",
      "workout",
      null
     ]
    },
    "draft_ref": {
     "type": [
      "string",
      "null"
     ],
     "description": "dft-ref (ör. dft3) — açık taslağın dft-ref’i"
    }
   },
   "required": [
    "op",
    "plan_type",
    "draft_ref"
   ],
   "additionalProperties": false
  },
  "simulation": {
   "anyOf": [
    {
     "type": "object",
     "description": "\"yesem ne olur?\" türü varsayım; kod bütçe sayısını hesaplar",
     "properties": {
      "food": {
       "type": "string"
      },
      "kcal_estimate": {
       "type": "number"
      },
      "target_day": {
       "type": "string",
